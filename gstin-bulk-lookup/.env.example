# ---------------------------------------------------------------------------
# Copy to .env and edit.  Everything has a working default except the provider
# credentials, so `npm run dev` works out of the box in demo mode.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# mock         Offline demo. SYNTHETIC data — no credentials, nothing real.
# gstincheck   GST India API (gstincheck.co.in)
# appyflow     Appyflow GST API (appyflow.in/gst-api)
# mastersindia Masters India, a GSTN-authorised GSP
# custom       Any endpoint returning the standard GSTN taxpayer payload
GSTIN_PROVIDER=mock

# --- gstincheck ---
GSTINCHECK_API_KEY=
# GSTINCHECK_BASE_URL=https://sheet.gstincheck.co.in

# --- appyflow ---
APPYFLOW_API_KEY=
# APPYFLOW_BASE_URL=https://appyflow.in

# --- mastersindia (all four are required) ---
MASTERSINDIA_CLIENT_ID=
MASTERSINDIA_CLIENT_SECRET=
MASTERSINDIA_USERNAME=
MASTERSINDIA_PASSWORD=
# Your own GSTIN, if your Masters India plan requires it on each request.
MASTERSINDIA_GSTIN=
# MASTERSINDIA_BASE_URL=https://commonapi.mastersindia.co

# --- custom endpoint ---
# "{gstin}" is substituted; if the placeholder is absent, ?gstin=... is appended.
CUSTOM_PROVIDER_URL=
CUSTOM_PROVIDER_METHOD=GET
# JSON object of extra headers.
CUSTOM_PROVIDER_HEADERS={"Authorization":"Bearer replace-me"}
# Dotted path to the GSTN payload inside the response. Blank means the root.
CUSTOM_PROVIDER_DATA_PATH=data

# ---------------------------------------------------------------------------
# Throughput and limits
# ---------------------------------------------------------------------------
# Largest batch accepted in one request.
MAX_BATCH_SIZE=500
# Parallel upstream calls. Raise only if your plan's rate limit allows it.
LOOKUP_CONCURRENCY=5
REQUEST_TIMEOUT_MS=15000
# Retries for timeouts / 429 / 5xx.
MAX_RETRIES=2
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Caching — registration details change rarely, so this saves real money
# ---------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_MINUTES=720
CACHE_MAX_ENTRIES=10000

# ---------------------------------------------------------------------------
# Rate limiting (per client IP, applied to /api/*)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# Simulated latency for the demo provider, in ms. 0 disables it.
MOCK_LATENCY_MS=200
