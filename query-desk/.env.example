# Copy this file to .env.local and fill in the values from your Firebase
# project's Web App config (Firebase Console > Project Settings > General >
# Your apps > Web app > SDK setup and configuration > Config).
#
# These values are not secret (they identify your Firebase project to the
# browser, access is still governed by firestore.rules and Firebase Auth),
# but are kept out of version control so each environment/deploy can use
# its own Firebase project without editing source.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
