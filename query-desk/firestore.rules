rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.raisedByUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.replyText == null
        && request.resource.data.replyByName == null
        && request.resource.data.replyDate == null
        && request.resource.data.dueDate == null;

      // Admin can update any mutable field (reply, status, dueDate).
      // The original question fields and attachment are immutable after creation.
      allow update: if isAdmin()
        && request.resource.data.questionText == resource.data.questionText
        && request.resource.data.raisedByUid == resource.data.raisedByUid
        && request.resource.data.raisedByName == resource.data.raisedByName
        && request.resource.data.dateRaised == resource.data.dateRaised
        && request.resource.data.attachmentUrl == resource.data.attachmentUrl
        && request.resource.data.attachmentName == resource.data.attachmentName;

      allow delete: if isAdmin();
    }
  }
}
